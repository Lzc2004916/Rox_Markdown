{
  "name": "rich-text-editor",
  "version": "1.0.0",
  "description": "A Rich Text Editor built with Electron + Vue 3 + TypeScript",
  "author": "Rox",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:app": "node scripts/clean-release.js && vue-tsc --noEmit && vite build && node scripts/generate-ico.js && electron-builder && node scripts/clean-unpacked.js",
    "build:mobile": "cross-env VITE_MOBILE_BUILD=true vue-tsc --noEmit && cross-env VITE_MOBILE_BUILD=true vite build",
    "ios:sync": "npm run build:mobile && npx cap sync ios",
    "ios:open": "npm run ios:sync && npx cap open ios",
    "ios:dev": "npm run build:mobile && npx cap run ios --livereload --external",
    "preview": "vite build && electron .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@capacitor/browser": "^8.0.4",
    "@capacitor/cli": "^8.4.2",
    "@capacitor/core": "^8.4.2",
    "@capacitor/filesystem": "^8.1.2",
    "@capacitor/ios": "^8.4.2",
    "@capacitor/share": "^8.0.1",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.2",
    "@codemirror/state": "^6.5.2",
    "@codemirror/theme-one-dark": "^6.1.2",
    "@codemirror/view": "^6.36.5",
    "axios": "^1.20.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^2.5.2",
    "mathjax-full": "^3.2.2",
    "pinia": "^2.3.1",
    "prismjs": "^1.30.0",
    "vue": "^3.5.16"
  },
  "devDependencies": {
    "@types/node": "^22.15.19",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vue/test-utils": "^2.4.11",
    "autoprefixer": "^10.4.20",
    "cross-env": "^10.1.0",
    "daisyui": "^4.12.0",
    "electron": "^35.2.1",
    "electron-builder": "^25.1.8",
    "happy-dom": "^20.10.6",
    "postcss": "^8.4.49",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.7.3",
    "vite": "^4.5.14",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.7",
    "vitest": "^4.1.10",
    "vue-tsc": "^2.2.10"
  },
  "build": {
    "appId": "com.richtexteditor.app",
    "productName": "Rox-Markdown",
    "icon": "build/icon.png",
    "afterPack": "./scripts/inject-icon.js",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "win": {
      "target": "nsis",
      "sign": null,
      "signAndEditExecutable": false,
      "signDlls": false
    },
    "asar": false,
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
